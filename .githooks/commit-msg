#!/bin/sh
# Conventional Commits header check, no dependencies.
# Enable once per clone: git config core.hooksPath .githooks
header=$(head -n 1 "$1")

case "$header" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].*[^.]$'
if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
  echo "commit-msg: header does not follow Conventional Commits:" >&2
  echo "  $header" >&2
  echo "  expected: <type>(<scope>): <subject>   e.g. feat(ui): add a copy action" >&2
  echo "  rules: .claude/skills/commit/COMMIT-MESSAGE.md" >&2
  exit 1
fi

if [ "${#header}" -gt 100 ]; then
  echo "commit-msg: header is ${#header} characters, max 100." >&2
  exit 1
fi
